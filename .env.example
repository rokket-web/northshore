# Server
PORT=3000

# Shared secret used to verify incoming Webflow webhook requests.
# Set the same value in Webflow's webhook config (sent as x-webhook-secret header),
# or adapt verifyWebhookSignature() in src/routes/webhook.js to Webflow's actual signing scheme.
WEBFLOW_WEBHOOK_SECRET=

# Azure AD app registration (client credentials flow) used to call Microsoft Graph
# and write the generated PDF into SharePoint. See README.md for setup steps.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint destination. SHAREPOINT_SITE_ID is the Graph site id (hostname,sitecollectionid,siteid),
# not the friendly URL. SHAREPOINT_DRIVE_PATH is the folder path within the site's default document
# library where PDFs should be saved, e.g. "Survey Responses".
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_PATH=Survey Responses

# Planning Center Online (People API) Personal Access Token, from
# https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=
PCO_SECRET=

# Mailbox this app sends "couldn't match to a PCO profile" alerts from, and the staff
# address that receives them. Sent via Microsoft Graph using the same Azure app above
# (needs the Mail.Send application permission — see README).
MAIL_SENDER_UPN=
STAFF_ALERT_EMAIL=

# Brevo SMTP relay. When SMTP_USER and BREVO_SMTP_KEY are set, all mail goes through Brevo
# instead of Graph. BREVO_SMTP_KEY is the SMTP key from Brevo > SMTP & API (not your login
# password). MAIL_FROM must be a sender/domain verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=bb21fc001@smtp-brevo.com
BREVO_SMTP_KEY=
MAIL_FROM=

# Password for the /recent, /submissions, and /dashboard admin pages (shows submitter
# names/emails, so it's gated behind this — those pages refuse to load at all if this
# isn't set). Any username works at the browser's login prompt, only the password is checked.
ADMIN_PASSWORD=

# Postgres connection string (Neon) used to persist /dashboard admin settings — see
# src/services/settingsStore.js. Locally this is auto-populated in .env.local by
# `neon link` (not this file); on Render, set it directly as a real env var, pulling
# the value from `neon connection-string` or the Neon console.
DATABASE_URL=
